# Email: configure SMTP through MAILERS, not through EMAIL_BACKEND, EMAIL_HOST,
# EMAIL_PORT or the other EMAIL_* backend settings Django 6.1 deprecates:
# hc/settings.py always defines MAILERS, and Django refuses them alongside it.
# MAILERS = {
#     "default": {
#         "BACKEND": "django.core.mail.backends.smtp.EmailBackend",
#         "OPTIONS": {
#             "host": "your-smtp-server-here.com",
#             "port": 587,
#             "username": "username",
#             "password": "password",
#             "use_tls": True,
#             "use_ssl": False,
#         },
#     },
# }
