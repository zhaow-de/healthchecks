# Docker Compose passes every line here to the web container, and reads
# HC_IMAGE, the image docker-compose.yml runs (default: the `latest` tag).
# HC_IMAGE=ghcr.io/zhaow-de/healthchecks:v<version>

# The database is SQLite at /data/hc.sqlite, the DB_NAME the image sets; a
# DB_NAME line here would replace it. With docker-compose.postgres.yml, which
# sets DB, DB_HOST, DB_NAME and DB_USER, set DB_PASSWORD; the other three
# tune the connection.
# DB_PASSWORD=fixme-postgres-password
# DB_CONN_MAX_AGE=0
# DB_SSLMODE=prefer
# DB_TARGET_SESSION_ATTRS=read-write

ALLOWED_HOSTS=localhost
DEBUG=False
DEFAULT_FROM_EMAIL=healthchecks@example.org
EMAIL_HOST=
EMAIL_HOST_PASSWORD=
EMAIL_HOST_USER=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_VERIFICATION=True
INTEGRATIONS_ALLOW_PRIVATE_IPS=False
LOG_FORMAT=text
PING_BODY_LIMIT=10000
PING_ENDPOINT=http://localhost:8000/ping/
PROMETHEUS_ENABLED=True
RP_ID=
SECRET_KEY=---
SITE_NAME=Healthchecks
SITE_ROOT=http://localhost:8000
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_ENABLED=True
WEBHOOKS_ENABLED=True
